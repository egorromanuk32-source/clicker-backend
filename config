const path = require('path');
const Database = require('better-sqlite3');

// Файл базы лежит в корне проекта, а не в config/
const DB_PATH = path.join(__dirname, '..', 'database.sqlite');

const db = new Database(DB_PATH);

db.pragma('journal_mode = WAL');

db.exec(`
  CREATE TABLE IF NOT EXISTS players (
    id INTEGER PRIMARY KEY,
    balance INTEGER NOT NULL DEFAULT 0,
    click_level INTEGER NOT NULL DEFAULT 0,
    auto_level INTEGER NOT NULL DEFAULT 0
  )
`);

// Дефолтный игрок (если его ещё нет)
db.prepare(`
  INSERT OR IGNORE INTO players (id, balance, click_level, auto_level)
  VALUES (1, 0, 0, 0)
`).run();

module.exports = db;
